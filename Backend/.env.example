NODE_ENV=development
PORT=5000
MONGO_URL=
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
# Use the deployed HTTPS origin for production provider callbacks.
PUBLIC_API_URL=http://localhost:5000
COOKIE_SAME_SITE=lax

# Google OAuth 2.0 web application credentials. Register the callback URL
# exactly as configured in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Required for administrator homepage image uploads and replacements.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay test keys are required to initialize and verify online payments.
# Use matching test/live keys from the same Razorpay account environment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Configure this same secret on the Razorpay webhook endpoint.
RAZORPAY_WEBHOOK_SECRET=

# Keep the Resend key on the backend; never add it to a VITE_ variable.
RESEND_API_KEY=re_your_new_api_key
EMAIL_FROM=onboarding@resend.dev
SUPPORT_EMAIL=
# Optional publicly accessible Nishree logo URL embedded in transactional emails.
MAIL_LOGO_URL=
