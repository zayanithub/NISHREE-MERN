NODE_ENV=development
PORT=5000
MONGO_URL=
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
COOKIE_SAME_SITE=lax

# Required for administrator homepage image uploads and replacements.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay test keys are required to initialize and verify online payments.
# Use matching test/live keys from the same Razorpay account environment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Configure this same secret on the Razorpay webhook endpoint.
RAZORPAY_WEBHOOK_SECRET=

# SMTP is used for customer sign-in, email verification, password recovery,
# and transactional email notifications. Use an app password where required.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
SUPPORT_EMAIL=
# Optional publicly accessible Nishree logo URL embedded in transactional emails.
MAIL_LOGO_URL=
